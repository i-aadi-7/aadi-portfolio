# Frontend Environment Variables (Exposed to client bundle)
# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous / Publishable API Key
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase Edge Function Secrets (NEVER prefix with VITE_ or expose in frontend)
# Set these in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# or via CLI: supabase secrets set RESEND_API_KEY="..." CONTACT_DESTINATION_EMAIL="..."
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# CONTACT_DESTINATION_EMAIL=
# RESEND_FROM_EMAIL=
